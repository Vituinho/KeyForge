# Railway staging backend ONLY. Replace placeholders; never reuse production secrets.
NODE_ENV=production
DATABASE_URL=postgresql://keyforge_app:REPLACE_PASSWORD@POSTGRES_PRIVATE_HOST:5432/keyforge_staging
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
BACKEND_PROXY_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
FRONTEND_ORIGIN=https://keyforge-staging.example.com

# Railway supplies PORT. Do not override it with a fixed localhost port.
RAILWAY_DOCKERFILE_PATH=backend/Dockerfile
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30

# Set replicas=1 and /health (120s) explicitly in Railway service settings.
# DATABASE_MIGRATION_URL belongs ONLY in a temporary operator/migration session.
# No DATABASE_MIGRATION_URL, owner credential or NEXT_PUBLIC_* secret in the running app.
