# Separate Vercel STAGING project/environment ONLY. Replace example hostnames.
BACKEND_URL=https://keyforge-staging-backend.example.com
BACKEND_PROXY_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
FRONTEND_ORIGIN=https://keyforge-staging.example.com
NEXT_PUBLIC_BACKEND_WS_URL=wss://keyforge-staging-backend.example.com/ws
NEXT_PUBLIC_SITE_URL=https://keyforge-staging.example.com

# Vercel determines NODE_ENV; vercel.json supplies the install/build commands.
# BACKEND_PROXY_SECRET must exactly match the Railway staging value.
# Never configure DATABASE_URL, DATABASE_MIGRATION_URL or BETTER_AUTH_SECRET here.
# Only the two public URL variables above belong in NEXT_PUBLIC_*.
