generator client {
  provider = "prisma-client"
  output = "../generated"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id
  name String
  usernameKey String @unique
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  player Player?
  hostedMatches Match[] @relation("Host")
  joinedMatches Match[] @relation("Guest")
  matchEvents MatchEvent[]
  queue Queue?
  tickets WsTicket[]
  legacy LegacyRecord[]
}
model Session {
  id String @id
  token String @unique
  userId String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets WsTicket[]
  @@index([userId])
}
model Account {
  id String @id
  userId String
  accountId String
  providerId String
  password String?
  accessToken String?
  refreshToken String?
  idToken String?
  scope String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@unique([providerId, accountId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt
}
model Player {
  userId String @id
  username String
  usernameKey String @unique
  profile Json
  version Int @default(0)
  inventory Json
  preferences Json @default("{}")
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  receipts Receipt[]
  challenges Challenge[]
}
model Receipt {
  id String @id @default(uuid())
  userId String
  source String
  binding String
  receipt Json
  createdAt DateTime @default(now())
  player Player @relation(fields: [userId], references: [userId], onDelete: Restrict)
  @@unique([userId, source])
}
model Challenge {
  id String @id @default(uuid())
  userId String
  challenge Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  finished Boolean @default(false)
  player Player @relation(fields: [userId], references: [userId], onDelete: Restrict)
  @@index([userId, createdAt])
}
model Match {
  id String @id @default(uuid())
  roomCode String? @unique
  player1 String
  player2 String?
  state Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events MatchEvent[]
  host User @relation("Host", fields: [player1], references: [id], onDelete: Restrict)
  guest User? @relation("Guest", fields: [player2], references: [id], onDelete: Restrict)
  queued Queue[]
  @@index([player1])
  @@index([player2])
}
model MatchEvent {
  id String @id @default(uuid())
  matchId String
  userId String
  eventId String
  binding String
  data Json
  createdAt DateTime @default(now())
  match Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([matchId, userId, eventId])
}
model Queue {
  userId String @id
  language String
  matchId String?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  match Match? @relation(fields: [matchId], references: [id], onDelete: Restrict)
}
model WsTicket {
  hash String @id
  userId String
  sessionId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
model LegacyRecord {
  sourceId String @id
  userId String?
  classification String
  snapshot Json
  importedAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
}
