# KeyForge Supabase Configuration
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server runtime only: set in the hosting provider's protected environment variables.
# Never prefix this variable with NEXT_PUBLIC or put a real value in Git/client code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Public canonical origin, configured before the production build (no path).
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
