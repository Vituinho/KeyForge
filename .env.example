# Next.js / Vercel: server-only proxy configuration
BACKEND_URL=http://127.0.0.1:4000
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PROXY_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:4000/ws
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node backend / Railway only. Never place these names in NEXT_PUBLIC variables.
DATABASE_URL=postgresql://keyforge_app:password@127.0.0.1:5432/keyforge
BETTER_AUTH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
PORT=4000

# Operator/migration job only; do not give the running app database ownership.
# DATABASE_MIGRATION_URL=postgresql://owner:password@127.0.0.1:5432/keyforge
