    "test:balance": "tsx scripts/test-balance-profiles.ts",
    "test:progression": "tsx scripts/verify-progression-polish.ts",
    "i18n:audit": "tsx scripts/audit-i18n.ts",
    "test": "tsx scripts/verify-release.ts --unit",
    "verify:release": "tsx scripts/verify-release.ts",
    "audit:audio": "tsx scripts/audit-audio.ts",
    "backend:generate": "prisma generate",
    "backend:build": "prisma generate && tsx scripts/build-backend.ts",
    "backend:start": "node backend/dist/server.mjs",
